{
    "name": "@mailflare/extension",
    "version": "2.0.0",
    "private": true,
    "description": "MailFlare - Email Alias Extension",
    "type": "module",
    "scripts": {
        "dev": "wxt --port 5555",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "postinstall": "wxt prepare",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@mailflare/core": "workspace:*",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@types/chrome": "^0.3.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@wxt-dev/module-react": "^1.2.2",
        "typescript": "catalog:",
        "wxt": "^0.21.5"
    }
}
